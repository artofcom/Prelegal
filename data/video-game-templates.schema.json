{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/artofcom/Prelegal/data/video-game-templates.schema.json",
  "title": "Prelegal Video Game Legal Template Dataset",
  "description": "Schema for a dataset of video game legal document templates and their replaceable variables.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "datasetId",
    "name",
    "version",
    "lastUpdated",
    "locale",
    "description",
    "disclaimer",
    "templates"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "description": "Optional path to this schema."
    },
    "datasetId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$",
      "description": "Stable identifier for the dataset."
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
      "description": "Semantic version of the dataset."
    },
    "lastUpdated": {
      "type": "string",
      "format": "date"
    },
    "locale": {
      "type": "string",
      "pattern": "^[a-z]{2}(-[A-Z]{2})?$",
      "description": "Language and region of the templates, such as en-US."
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "disclaimer": {
      "type": "string",
      "minLength": 1
    },
    "templates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/template"
      }
    }
  },
  "$defs": {
    "template": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "slug",
        "title",
        "category",
        "summary",
        "description",
        "jurisdiction",
        "tags",
        "version",
        "variables",
        "sections"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$",
          "description": "Stable machine-readable identifier for the template."
        },
        "slug": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$",
          "description": "URL-friendly identifier for the template."
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "category": {
          "type": "string",
          "enum": [
            "Licensing",
            "Terms of Service",
            "Privacy",
            "Confidentiality",
            "Contracting",
            "Monetization",
            "Community",
            "Compliance",
            "Promotions"
          ]
        },
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "jurisdiction": {
          "type": "string",
          "minLength": 1,
          "description": "Default jurisdiction and a reminder to adapt the template."
        },
        "tags": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          }
        },
        "version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "variables": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/variable"
          }
        },
        "sections": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/section"
          }
        }
      }
    },
    "variable": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "label",
        "type",
        "required",
        "example",
        "description"
      ],
      "properties": {
        "key": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$",
          "description": "Placeholder key used inside template sections as {{key}}."
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "type": "string",
          "enum": [
            "string",
            "text",
            "number",
            "boolean",
            "date",
            "url",
            "email"
          ]
        },
        "required": {
          "type": "boolean"
        },
        "example": {
          "type": "string"
        },
        "description": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "section": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "heading",
        "body"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "heading": {
          "type": "string",
          "minLength": 1
        },
        "body": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
